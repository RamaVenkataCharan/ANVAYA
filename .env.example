# ===================================================
# ANVAYA Environment Configuration
# ===================================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anvaya?schema=public"

# Authentication & JWT Secrets (Replace with secure random strings in production)
JWT_ACCESS_SECRET=anvaya_jwt_access_super_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=anvaya_jwt_refresh_super_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 Compatible File Storage (AWS S3 / Cloudflare R2)
S3_BUCKET=anvaya-medical-records
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=

# Client Application URLs (CORS)
CLIENT_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
