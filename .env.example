# ===================================================
# ANVAYA Monorepo Environment Configuration (.env.example)
# ===================================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database Connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/anvaya?schema=public"

# Authentication & JWT Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_placeholder
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin Authorization Code
ADMIN_REGISTRATION_CODE=ANVAYA_ADMIN_REGISTRATION_SECRET_CODE

# Demo Credentials Password
DEMO_PASSWORD=Password123

# Client Application URLs & CORS
CLIENT_URL=http://localhost:8081
WEB_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Mobile Application Backend API Target
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Web Frontend Backend API Target
VITE_API_URL=http://localhost:4000/api/v1

# S3 Compatible File Storage
S3_BUCKET=your_s3_bucket_name
S3_REGION=auto
S3_ENDPOINT=https://your-s3-endpoint.example.com
S3_ACCESS_KEY=your_s3_access_key_id
S3_SECRET_KEY=your_s3_secret_access_key

# Expo Push Notifications (Optional)
EXPO_ACCESS_TOKEN=
