{
  "name": "anvaya-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ANVAYA - Paperless Healthcare Ecosystem connecting Doctors, Medical Shops, and Patients",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=apps/server run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:mobile": "npm --workspace=apps/mobile run start",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:server": "npm --workspace=apps/server run build",
    "build:web": "npm --workspace=apps/web run build",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "db:generate": "npm --workspace=apps/server run db:generate",
    "db:migrate": "npm --workspace=apps/server run db:migrate",
    "db:deploy": "npm --workspace=apps/server run db:deploy",
    "db:push": "npm --workspace=apps/server run db:push",
    "db:seed": "npm --workspace=apps/server run db:seed",
    "db:studio": "npm --workspace=apps/server run db:studio",
    "seed": "npm --workspace=apps/server run seed",
    "test": "npm --workspace=apps/server run test",
    "test:postgres": "npm --workspace=apps/server run test:postgres",
    "typecheck": "npm --workspace=packages/shared run build && npx tsc --noEmit -p packages/shared/tsconfig.json && npx tsc --noEmit -p apps/server/tsconfig.json && npx tsc --noEmit -p apps/web/tsconfig.json && npx tsc --noEmit -p apps/mobile/tsconfig.json"
  },
  "keywords": [
    "healthcare",
    "paperless",
    "e-prescription",
    "telehealth",
    "pharmacy-billing"
  ],
  "overrides": {
    "tar": "7.5.22",
    "react-server-dom-webpack": "19.0.0"
  },
  "author": "ANVAYA Team",
  "license": "ISC"
}
