# ANVAYA Mobile Environment Variables

# Backend API base URL (including API prefix /api/v1)
# IMPORTANT:
# - When running on Web or iOS Simulator, 'http://localhost:4000/api/v1' is fine.
# - When running on Android Emulator, use 'http://10.0.2.2:4000/api/v1' or your LAN IP.
# - When testing on a PHYSICAL DEVICE (via Expo Go or dev client on iOS/Android),
#   you MUST set this to your computer's local network IP (e.g. 'http://192.168.1.50:4000/api/v1').
#   'localhost' on a physical device points to the phone itself, not your development machine!
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
